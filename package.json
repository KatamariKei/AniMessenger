{
  "name": "animessenger",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first character messenger with independent character discovery, Ollama chat, and optional ComfyUI images.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:detached": "node scripts/start-detached.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:tray": "node scripts/build-dev-tray.mjs --start",
    "dev:tray:build": "node scripts/build-dev-tray.mjs",
    "dev:service": "node scripts/tray-service.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server/index.mjs --serve-dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "assets:verify": "node scripts/verify-image-assets.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
